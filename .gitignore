# Config files
# Ignore all user/local configs by default.
configs/*.yaml
configs/*.yml
configs/local/
configs/local*.yaml
configs/local*.yml
configs/*.local.yaml
configs/*.local.yml

# Track only official example configs.
!configs/anomalib_dataset_example.yaml
!configs/custom_folder_dataset_example.yaml
