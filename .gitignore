**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE/editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Project generated outputs
outputs/
benchmark_outputs/
*.zip
